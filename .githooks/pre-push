#!/usr/bin/env bash
# .githooks/pre-push
#
# Git pre-push hook — runs validate-before-push.sh --fast before allowing a push.
# Catches lint + typecheck errors. Skips the full build (takes ~2min) for speed.
#
# To install (one-time setup, run from repo root):
#   git config core.hooksPath .githooks
#   chmod +x .githooks/pre-push
#
# To bypass (emergency only):
#   git push --no-verify

echo "▶ Running pre-push validation (fast mode)..."
echo "  (to bypass: git push --no-verify)"

REPO_ROOT="$(git rev-parse --show-toplevel)"

if [[ -f "$REPO_ROOT/scripts/validate-before-push.sh" ]]; then
  if bash "$REPO_ROOT/scripts/validate-before-push.sh" --fast; then
    echo "✓ Pre-push validation passed — pushing..."
    exit 0
  else
    echo ""
    echo "✗ Pre-push validation FAILED."
    echo "  Fix the errors above, then retry."
    echo "  To bypass (emergency only): git push --no-verify"
    exit 1
  fi
else
  echo "⚠ validate-before-push.sh not found — skipping validation"
  exit 0
fi
