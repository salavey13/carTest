{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "tsBuildInfoFile": ".next/cache/tsconfig.franchize.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "app/franchize/components/MapRidersClient.tsx",
    "app/franchize/components/FranchizeProfileButton.tsx",
    "app/franchize/profile-actions.ts",
    "hooks/useMapRidersContext.tsx",
    "components/map-riders/MapRidersClientRefactored.tsx",
    "components/map-riders/BeginnerRiderOnboardingQuiz.tsx",
    "components/map-riders/RiderFAB.tsx",
    "components/map-riders/StatusOverlay.tsx",
    "components/map-riders/RiderMarkerLayer.tsx",
    "components/map-riders/RidersDrawer.tsx",
    "app/franchize/lib/bike-wall.ts",
    "app/franchize/server-actions/bike-wall.ts",
    "app/franchize/lib/superlist-clear.ts",
    "app/franchize/lib/superlist-clear-core.ts",
    "app/franchize/[slug]/bikes/page.tsx",
    "app/franchize/[slug]/bikes/BikesWallClient.tsx",
    "app/franchize/[slug]/bikes/[bikeId]/page.tsx",
    "app/franchize/[slug]/bikes/[bikeId]/BikeStoryClient.tsx",
    "app/franchize/lib/community-wall.ts",
    "app/franchize/lib/wall-access.ts",
    "app/franchize/lib/wall-notify.ts",
    "app/franchize/server-actions/community-wall.ts",
    "app/api/franchize/wall-photo-upload/route.ts",
    "app/franchize/[slug]/community/page.tsx",
    "app/franchize/[slug]/community/CommunityWallClient.tsx"
  ],
  "exclude": ["node_modules", ".next"]
}
