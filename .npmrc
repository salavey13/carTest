# Keep npm output clean in proxy-injected environments where legacy npm_config_http_proxy
# is auto-set and triggers warn-level noise on every command.
loglevel=error
# TASK160 (deploy speed): npm по умолчанию роняет установку с первого сетевого
# сбоя (реестр/зеркало бинарей sharp @img/*) — deploi падал и перезапускался
# «по три попытки». Ретраи на уровне npm переживают короткие сбои сети внутри
# ОДНОГО docker build.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
