{
  "functions": {
    "app/api/telegramWebhook/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/cleanup-wallpix-staging/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/wall-renter-notify",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/cleanup-wallpix-staging",
      "schedule": "30 3 * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/search",
      "methods": ["POST"],
      "dest": "/api/search"
    },
    {
      "src": "/api/telegramWebhook",
      "methods": ["POST"],
      "dest": "/api/telegramWebhook/route"
    }
  ]
}