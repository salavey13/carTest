# ===== Core Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ===== Telegram Bot =====
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
ADMIN_CHAT_ID=your_personal_telegram_chat_id

# ===== GitHub / Codex workflow =====
GITHUB_TOKEN=ghp_yourgithubtoken

# ===== AI provider =====
GEMINI_API_KEY=your_gemini_api_key

# ===== Public app URL =====
# Use your Vercel production URL or custom domain.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ===== Optional local mock user =====
# NEXT_PUBLIC_USE_MOCK_USER=false
# MOCK_USER_DETAILS='{"id":123456,"first_name":"Mock","last_name":"User","username":"mockuser","language_code":"en"}'

# ===== Slack Codex bridge =====
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CODEX_CHANNEL_ID=C012345678
# optional, defaults to @codex
SLACK_CODEX_MENTION=@codex
# optional alternative to token+channel mode
SLACK_INCOMING_WEBHOOK_URL=https://hooks.slack.com/services/T/B/XXX

# ===== Codex bridge callback (optional automation) =====
CODEX_BRIDGE_CALLBACK_SECRET=super-secret-shared-token
VERCEL_PROJECT_NAME=v0-car-test
# e.g. -salavey13s-projects.vercel.app (or .salavey13s-projects.vercel.app)
VERCEL_PREVIEW_DOMAIN_SUFFIX=your-team-scope.vercel.app

# ===== Slack OAuth token rotation (optional alternative to SLACK_BOT_TOKEN) =====
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REFRESH_TOKEN=xoxe-1-rotating-refresh-token

# ===== Yandex SMTP for email notifications =====
# Get app password: https://id.yandex.ru/security/app-passwords
SMTP_YANDEX_HOST=smtp.yandex.ru
SMTP_YANDEX_PORT=465
SMTP_YANDEX_USER=your-email@yandex.ru
SMTP_YANDEX_PASS=your-yandex-app-password
EMAIL_FROM=your-email@yandex.ru

# ===== Gmail SMTP (alternative) =====
# Get app password: https://myaccount.google.com/apppasswords
# SMTP_GMAIL_HOST=smtp.gmail.com
# SMTP_GMAIL_PORT=587
# SMTP_GMAIL_USER=your-email@gmail.com
# SMTP_GMAIL_PASS=your-gmail-app-password


# ===== Avito Messenger API (ответы покупателям из CRM) =====
# Приложение: https://developers.avito.ru → «Мои приложения» → скоупы
# messenger:read (входящие, уже используется) + messenger:write (исходящие).
# Требуется подписка «API Мессенджера» на аккаунте Авито (иначе HTTP 402).
# AVITO_USER_ID — id профиля продавца-владельца объявлений (аренда: 167526519,
# см. scripts/avito-monitor/config.json).
# AVITO_CLIENT_ID=
# AVITO_CLIENT_SECRET=
# AVITO_USER_ID=
# ── Второй аккаунт Авито (продажа и т.п.) ────────────────────────────────────
# Webhook второго аккаунта регистрируется с ?acc=<key> в URL (напр. ?acc=sale)
# → лид получает metadata.avitoAccount=sale, ответы в его чаты идут с его creds:
# AVITO_ACCOUNT_<KEY>_CLIENT_ID / _CLIENT_SECRET / _USER_ID
# (напр. AVITO_ACCOUNT_SALE_CLIENT_ID=..., AVITO_ACCOUNT_SALE_USER_ID=363186771)

# ===== Карта map-riders (Leaflet) =====
# Базовые слои (CARTO dark/light + OSM) работают БЕЗ api-ключа: полоска внизу
# карты — это обязательная лицензионная атрибуция OSM/CARTO, а не watermark.
# Хочется премиум-базовую карту или ключевого провайдера (MapTiler и т.п.)?
# 1) https://www.maptiler.com → Sign up → Account → API keys → Create
#    (free-тариф: ~100k загрузок карты/мес, без привязки банковской карты)
# 2) Вставить ключ в URL ниже и задать обе переменные в Vercel → redeploy.
#    Обе НЕобязательны: пусто = дефолтный CARTO.
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
